# Configuracion del servicio de catalogo.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-catalog
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3003
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI. Deshabilitada en produccion por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory: repositorio en proceso, suficiente para desarrollo y pruebas.
# mongo: requiere ADR-005 aprobado y MONGODB_URI informado.
PERSISTENCE_DRIVER=memory
MONGODB_URI=

# --- Recursos visuales de Producto ---------------------------------------
# memory: adaptador local para desarrollo y pruebas.
# s3:     bucket privado de Infrastructure definido por ADR-016.
#
# Al activar s3, API_BASE_URL es obligatoria: Catalog persiste URLs canónicas
# propias y solo redirige a URLs firmadas y temporales de S3 al leer contenido.
ASSETS_STORAGE_DRIVER=memory
PRODUCT_ASSETS_BUCKET_NAME=
AWS_REGION=us-east-1
API_BASE_URL=

# false conserva temporalmente imageUrl externas durante la transición.
# true acepta solo assets READY emitidos por /api/v1/catalog/product-assets.
ASSETS_ENFORCE_STRICT=false

# --- Autenticacion --------------------------------------------------------
# disabled: ninguna ruta comprueba quien realiza la peticion. Es el estado que
#           describe el BLOCKER de ADR-004, no una opcion de conveniencia.
# jwt:      se exige un testimonio firmado por el user pool de Cognito.
#
# Con NODE_ENV=production, "disabled" IMPIDE ARRANCAR el servicio. Un aviso en
# el registro se pasa por alto; un arranque que falla, no.
AUTH_MODE=disabled

# Obligatorios cuando AUTH_MODE=jwt. Los emite Terraform como salidas del
# modulo `identity` en Nexus-Battle-Infrastructure. Ninguno es un secreto: el
# identificador del cliente publico viaja en la URL de inicio de sesion.
#
# Los valores de abajo son los REALES del entorno ya aprovisionado
# (`infra/envs/prod` de Nexus-Battle-Infrastructure). Estan aqui porque no son
# secretos, y porque con ellos informados activar la verificacion de identidad
# es cambiar una sola variable: AUTH_MODE a `jwt`.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# Contrato interno con Account para comprobar la evidencia de segundo factor.
# Sin ACCOUNT_INTERNAL_URL o INTERNAL_SERVICE_AUTH_SECRET, las mutaciones
# administrativas fallan CERRADAS con 503: no quedan abiertas.
# NO commitear un secreto real: este es un marcador.
ACCOUNT_INTERNAL_URL=http://account:3000
INTERNAL_SERVICE_AUTH_SECRET=
INTERNAL_SERVICE_NAME=catalog
INTERNAL_TIMEOUT_MS=3000
